{
  "name": "studykb",
  "version": "1.0.0",
  "description": "KB — local study practice site for LLD, HLD, AI and DSA, with AI evaluation and a tutor chat (Claude, OpenAI or Ollama)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:lan": "node server.js --lan",
    "kb": "node bin/kb.js",
    "pending": "node bin/kb.js pending",
    "new-day": "node scripts/new-day.js",
    "build:content": "node build/assemble.js",
    "build:editor": "esbuild build/toastui-entry.js --bundle --format=iife --minify --outfile=public/vendor/toastui-editor.js",
    "start:local": "node server.js --local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "express": "^4.22.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource/kalam": "^5.3.0",
    "esbuild": "^0.28.2"
  },
  "bin": {
    "kb": "bin/kb.js"
  },
  "engines": {
    "node": ">=18"
  }
}
